OPENAI_API_KEY=
OPENAI_BASE_URL=
WEBLENS_ARTIFACT_ROOT=./runs
WEBLENS_MODEL=gpt-5.4-mini
WEBLENS_ESTIMATED_RUN_COST_USD=
WEBLENS_PRICING_VERSION=
WEBLENS_INPUT_USD_PER_MILLION_TOKENS=
WEBLENS_OUTPUT_USD_PER_MILLION_TOKENS=
# Chỉ bật miền công khai đã được cho phép trong src/network-allowlist.ts (PNJ hoặc ATAD).
WEBLENS_NETWORK_ENFORCEMENT=verified:local-public-allowlist
# Anti-bot capture inspired by Scrapling StealthyFetcher (0/1/stealthy). Keeps network policy fail-closed.
WEBLENS_STEALTH=0
# WEBLENS_STEALTH_REAL_CHROME=1
# WEBLENS_STEALTH_SOLVE_CLOUDFLARE=1
# WEBLENS_STEALTH_CHALLENGE_TIMEOUT_MS=60000
